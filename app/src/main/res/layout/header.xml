<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingBottom="12dp">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="@string/app_name"
        android:textSize="26sp" android:fontFamily="sans-serif-medium"
        android:accessibilityHeading="true" />
    <Button android:id="@+id/help" style="@style/PlainButton"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:minWidth="64dp" android:text="@string/help" />
</LinearLayout>
